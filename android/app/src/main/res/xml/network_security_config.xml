<?xml version="1.0" encoding="utf-8"?>
<!-- Offline-first app: no cleartext HTTP; system CAs only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
